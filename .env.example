# Application
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=super_secret_jwt_key_min_64_characters_long_for_security_1234567890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Database (PostgreSQL)
# Replace with your instance URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resultflow?schema=public"

# Redis
# Replace with your instance URL
REDIS_URL="redis://localhost:6379"

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# PDF Worker
PDF_WORKER_CONCURRENCY=3

# File Limits
MAX_TEMPLATE_SIZE_MB=20
MAX_DATA_ROWS=10000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs
