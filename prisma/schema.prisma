// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  templates       Template[]
  generationJobs  GenerationJob[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

enum UserRole {
  USER
  ADMIN
}

// ─────────────────────────────────────────
// TEMPLATES
// ─────────────────────────────────────────

model Template {
  id           String         @id @default(cuid())
  userId       String
  name         String
  description  String?
  fileType     TemplateType
  filePath     String
  fileSize     Int
  pageWidth    Float          // in points (PDF unit)
  pageHeight   Float
  thumbnailPath String?
  isDeleted    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  editorVersion   String            @default("v2")
  generationJobs  GenerationJob[]
  document        TemplateDocument?
  components      TemplateComponent[]
  versions        TemplateVersion[]

  @@index([userId])
  @@map("templates")
}

// Document Model — stored as a single JSON blob per template version
model TemplateDocument {
  id         String   @id @default(uuid())
  templateId String   @unique
  version    Int      @default(1)
  document   Json     // The full Document Model JSON

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("template_documents")
}

// Component — individual visual element on the canvas
model TemplateComponent {
  id         String        @id @default(uuid())
  templateId String
  type       ComponentType
  fieldKey   String?       // maps to Excel column via ColumnMapping
  label      String?
  properties Json          // All visual properties (see Document Model spec)
  zIndex     Int           @default(0)
  pageNumber Int           @default(1)
  isVisible  Boolean       @default(true)
  isLocked   Boolean       @default(false)

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@map("template_components")
}

enum ComponentType {
  TEXT
  STATIC_TEXT
  IMAGE
  QR_CODE
  BARCODE
  SHAPE_RECT
  SHAPE_ELLIPSE
  LINE
}

// Template version history for undo across sessions (future-ready)
model TemplateVersion {
  id         String @id @default(uuid())
  templateId String
  version    Int
  snapshot   Json   // Full Document Model at this version
  createdBy  String // userId

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([templateId, version])
  @@index([templateId])
  @@map("template_versions")
}

enum TemplateType {
  PDF
  PNG
  JPG
}

// ─────────────────────────────────────────
// GENERATION JOBS
// ─────────────────────────────────────────

model GenerationJob {
  id              String    @id @default(cuid())
  userId          String
  templateId      String
  dataFilePath    String
  columnMapping   Json      // { excelColumn: systemFieldKey }
  totalRows       Int
  processedRows   Int       @default(0)
  failedRows      Int       @default(0)
  status          JobStatus @default(PENDING)
  zipFilePath     String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user                User                @relation(fields: [userId], references: [id])
  template            Template            @relation(fields: [templateId], references: [id])
  generatedDocuments  GeneratedDocument[]
  jobLogs             JobLog[]

  @@index([userId])
  @@index([status])
  @@map("generation_jobs")
}

model GeneratedDocument {
  id          String    @id @default(cuid())
  jobId       String
  rowIndex    Int
  identifier  String    // Roll number or unique ID
  filePath    String
  fileSize    Int
  status      DocStatus @default(SUCCESS)
  errorMessage String?
  createdAt   DateTime  @default(now())

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("generated_documents")
}

model JobLog {
  id        String   @id @default(cuid())
  jobId     String
  level     LogLevel
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_logs")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DocStatus {
  SUCCESS
  FAILED
}

enum LogLevel {
  INFO
  WARN
  ERROR
}
